{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-light.local/benchmarks/real_world_eval_schema.json",
  "title": "Smart Light Real-World Evaluation Record",
  "type": "object",
  "required": [
    "session_id",
    "timestamp",
    "condition",
    "scenario",
    "ground_truth_emotion",
    "predicted_emotion",
    "prediction_confidence"
  ],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "participant": { "type": ["string", "null"] },
    "timestamp": { "type": "number" },
    "condition": { "type": "string", "enum": ["adaptive", "control", "unknown"] },
    "scenario": {
      "type": "object",
      "required": ["lighting", "occlusion", "head_pose", "background_noise"],
      "properties": {
        "lighting": { "type": "string", "enum": ["bright", "normal", "low_light", "backlit", "mixed"] },
        "occlusion": { "type": "string", "enum": ["none", "partial", "strong"] },
        "head_pose": { "type": "string", "enum": ["frontal", "moderate", "extreme"] },
        "background_noise": { "type": "string", "enum": ["silent", "low", "medium", "high"] }
      },
      "additionalProperties": true
    },
    "ground_truth_emotion": {
      "type": "string",
      "enum": ["happy", "sad", "angry", "fear", "surprise", "disgust", "neutral"]
    },
    "predicted_emotion": {
      "type": "string",
      "enum": ["happy", "sad", "angry", "fear", "surprise", "disgust", "neutral"]
    },
    "prediction_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "guardrail_active": { "type": "boolean", "default": false },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
